# ============================================================
# ECOSHIELD AI - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# ------------------------------------------------------------
# APPLICATION ENVIRONMENT
# ------------------------------------------------------------

# Allowed values:
# development
# testing
# production
APP_ENV=development


# ------------------------------------------------------------
# ASSESSMENT / BACKEND MODE
# ------------------------------------------------------------

# Allowed values:
# deterministic
# rag
# ai
#
# deterministic:
#   Validation + Risk + Deterministic Recommendations
#
# rag:
#   Deterministic result + retrieved knowledge evidence
#
# ai:
#   Deterministic result + RAG grounding + LLM explanation
#
# Safe default:
# deterministic
ASSESSMENT_MODE=deterministic


# ------------------------------------------------------------
# LLM PROVIDER
# ------------------------------------------------------------

# Allowed values:
# ollama
# openai_compatible
# ibm_granite
#
# Only required when ASSESSMENT_MODE=ai.
LLM_PROVIDER=ollama


# ------------------------------------------------------------
# LLM MODEL
# ------------------------------------------------------------

# Example local Ollama model:
# qwen2.5:3b
LLM_MODEL=qwen2.5:3b


# ------------------------------------------------------------
# LLM BASE URL
# ------------------------------------------------------------

# Ollama default:
# http://localhost:11434
#
# For cloud/OpenAI-compatible providers, replace this with
# the provider's compatible API base URL.
LLM_BASE_URL=http://localhost:11434


# ------------------------------------------------------------
# LLM API KEY
# ------------------------------------------------------------

# Leave empty for providers that do not require an API key,
# such as a local Ollama installation.
#
# Never commit a real key to source control.
LLM_API_KEY=


# ------------------------------------------------------------
# LLM GENERATION SETTINGS
# ------------------------------------------------------------

# Recommended safe/default temperature.
LLM_TEMPERATURE=0.2

# Maximum number of generated output tokens.
LLM_MAX_OUTPUT_TOKENS=600

# Provider request timeout in seconds.
# Local Ollama generation can take longer on some systems.
LLM_TIMEOUT_SECONDS=300


# ------------------------------------------------------------
# OPTIONAL PROJECT / PROVIDER METADATA
# ------------------------------------------------------------

# Optional provider-specific project identifier.
# Leave empty when unused.
LLM_PROJECT_ID=